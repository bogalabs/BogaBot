# ==========================================================================
# BogaBot - Variables de entorno
# Copiá este archivo a ".env" y completá los valores reales.
# El archivo .env NUNCA se commitea (está en .gitignore).
# ==========================================================================

# --- Discord ---------------------------------------------------------------
# Token del bot (Discord Developer Portal > Bot > Reset Token).
DISCORD_TOKEN=

# ID del servidor (guild) donde vive el bot. Opcional pero MUY recomendado:
# si lo ponés, los slash commands se registran al instante en ese server.
# Si lo dejás vacío, se registran globalmente y Discord tarda hasta ~1 hora.
DISCORD_GUILD_ID=

# ID del canal PRIVADO/oculto que el bot usa como "base de datos".
# Ahí postea los datos crudos de cada partida y los vínculos. Nadie más
# debería escribir en ese canal. El bot necesita permiso de leer y escribir.
STORAGE_CHANNEL_ID=

# ID del canal donde el bot posteará los rankings ("#trolleadas" en la documentación)
RANKING_CHANNEL_ID=
# ID del canal #general para notificar los "PAPELON"
GENERAL_CHANNEL_ID=

# ID del rol que puede usar comandos de administración (ej. /link-admin).
DEV_ROLE_ID=

# ID del canal donde se pueden correr los comandos de administración.
# Opcional: si se deja vacío, el comando funciona en cualquier canal
# (pero sigue exigiendo DEV_ROLE_ID).
ADMIN_CHANNEL_ID=

# ID del rol de jugador/miembro del grupo. Se usa solo para mostrar el menú
# correcto en /help y /ayuda (no restringe comandos de ranking).
PLAYER_ROLE_ID=

# ID del rol que se le asigna automáticamente a un usuario cuando se vincula
# (/link o /link-admin). Sirve para darle acceso a los canales de LoL sin
# molestar al resto del server. Opcional: si se deja vacío, no se asigna
# ningún rol al vincular.
LOL_ROLE_ID=

# ID del canal donde se avisa "en vivo" cuando termina una partida (etiqueta
# a los jugadores del grupo que la jugaron). Opcional: si se deja vacío, no
# se manda ningún aviso y solo se ingiere en el job diario / /ingest-now.
MATCH_NOTIFY_CHANNEL_ID=

# Cada cuántos minutos se chequean partidas nuevas para los avisos de arriba.
MATCH_POLL_INTERVAL_MINUTES=5

# --- Riot Games ------------------------------------------------------------
# API key (https://developer.riotgames.com/). La dev key vence cada 24h.
RIOT_API_KEY=

# Plataforma del server de LoL. LAS = la2. (LAN=la1, NA=na1, EUW=euw1, ...)
RIOT_PLATFORM=la2

# Routing regional para account-v1 y match-v5. LAS/LAN/NA/BR -> americas.
# (Europa -> europe, Asia/Korea -> asia)
RIOT_REGION=americas

# --- Scoring ---------------------------------------------------------------
# Ruta al archivo de configuración del motor de puntaje (relativa a la raíz).
SCORING_CONFIG_PATH=config/scoring.yaml

# --- Scheduler / tiempo ----------------------------------------------------
# Zona horaria (IANA). Define los cortes de "día" y "semana" del ranking.
TIMEZONE=America/Argentina/Buenos_Aires

# Hora y minuto local a los que corre el job diario y se postean los rankings.
# Recomendado: cerca de medianoche (ej. 23:55) para que el ranking de "hoy"
# ya incluya casi todas las partidas del día (si corriera muy temprano a la
# mañana, el día recién arrancado tendría pocas o ninguna partida).
DAILY_POST_HOUR=23
DAILY_POST_MINUTE=55

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# ID de un canal donde el bot manda sus propios logs (no solo datos). Opcional:
# si se deja vacío, el bot solo loguea a la consola/terminal como antes.
LOG_CHANNEL_ID=

# Nivel mínimo que se manda al canal de logs (no afecta LOG_LEVEL, que sigue
# controlando la consola). WARNING por defecto para no saturar el canal con
# el chequeo periódico de partidas nuevas (MATCH_POLL_INTERVAL_MINUTES).
LOG_CHANNEL_LEVEL=WARNING
