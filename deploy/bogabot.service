[Unit]
Description=BogaBot - Discord bot de ranking LoL
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bogabot
WorkingDirectory=/home/bogabot/BogaBot
ExecStart=/home/bogabot/BogaBot/venv/bin/python run.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
